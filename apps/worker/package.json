{
  "name": "@eventsphere/worker",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:seed:local": "wrangler d1 execute DB --local --file=../../migrations/0002_seed_data.sql",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "d1:seed:remote": "wrangler d1 execute DB --remote --file=../../migrations/0002_seed_data.sql"
  },
  "dependencies": {
    "@eventsphere/shared": "*",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.109.2"
  }
}
