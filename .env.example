# EventSphere Environment Configuration

# JWT Secret for signing tokens (Must be at least 32 characters in production)
JWT_SECRET=eventsphere-super-secure-production-secret-key-change-me

# Admin bootstrap token for initial deployment setup (optional)
ADMIN_BOOTSTRAP_SECRET=admin-bootstrap-secret-token

# Environment
ENVIRONMENT=development

# Allowed CORS Origins (comma separated or specific origin)
CORS_ORIGIN=http://localhost:5173

# Frontend API URL (for web app)
VITE_API_URL=http://localhost:8787
